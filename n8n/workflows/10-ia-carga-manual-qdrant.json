    {
      "id": "ia01-leer",
      "name": "Leer manual y dividir por escenario",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\n// Lee los .md del manual operativo (montado de solo lectura en /manual), los divide por escenario (\"## \")\n// y devuelve un item por fragmento, con metadatos para citar la fuente.\nconst fs = require('fs');\nconst DIR = '/manual';\nconst MAX = 1500;\nconst salida = [];\nfor (const archivo of fs.readdirSync(DIR).filter((f) => f.endsWith('.md')).sort()) {\n  const texto = fs.readFileSync(DIR + '/' + archivo, 'utf8').replace(/\\r/g, '');\n  const titulo = (texto.match(/^# (.+)$/m) || [null, archivo])[1];\n  for (const parte of texto.split(/^(?=## )/m)) {\n    const t = parte.trim();\n    if (t.length < 80) continue;\n    const seccion = (t.match(/^## (.+)$/m) || [null, 'Introducción'])[1];\n    const codigo = (seccion.match(/^([A-Z]{2,4}-\\d{2})\\b/) || [null, ''])[1];\n    // partir secciones largas por parrafos, repitiendo el encabezado en cada pieza para no perder el contexto\n    const bloques = t.split(/\\n{2,}/);\n    let actual = '';\n    const piezas = [];\n    for (const b of bloques) {\n      if ((actual + '\\n\\n' + b).length > MAX && actual) { piezas.push(actual); actual = ''; }\n      actual = actual ? actual + '\\n\\n' + b : b;\n    }\n    if (actual) piezas.push(actual);\n    piezas.forEach((pz, i) => {\n      const cuerpo = i === 0 ? pz : `## ${seccion} (continuación)\\n\\n${pz}`;\n      salida.push({ json: { text: `Manual: ${titulo}\\n${cuerpo}`, fuente: archivo, seccion, codigo } });\n    });\n  }\n}\nif (!salida.length) throw new Error('No se encontró ningún .md en /manual');\nreturn salida;\n"
      }
    },
