# Configuración de PostgreSQL
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=tu_password
DB_HOST=localhost

# Puerto de la API (opcional, por defecto 3000)
PORT=3000

# Correo SMTP (nodemailer)
EMAIL_USER=tu_correo@ejemplo.com
EMAIL_PASS=tu_password_de_aplicacion

# Clave para firmar tus tokens JWT
JWT_SECRET=tu_clave_secreta_jwt
JWT_EXPIRES_IN=24h

# OAuth de Google 
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# Gemini API
GEMINI_API_KEY=tu_gemini_api_key

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=tu_mercadopago_access_token
ACCESS_TOKEN=tu_mercadopago_access_token

# pgAdmin 4 Configuration
PGADMIN_DEFAULT_EMAIL=admin@rayuela.com
PGADMIN_DEFAULT_PASSWORD=pgadmin_rayuela_2024
PGADMIN_PORT=5050