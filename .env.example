# Configuración de PostgreSQL
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=tu_password
DB_HOST=localhost

# Puerto de la API (opcional, por defecto 3000)
PORT=3000

# Correo SMTP (nodemailer)
EMAIL_USER=tu_correo@ejemplo.com
EMAIL_PASS=tu_password_de_aplicacion

# Clave para firmar tus tokens JWT
JWT_SECRET=tu_clave_secreta_jwt
JWT_EXPIRES_IN=24h

# OAuth de Google 
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# Gemini API
GEMINI_API_KEY=tu_gemini_api_key

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=tu_mercadopago_access_token
ACCESS_TOKEN=tu_mercadopago_access_token

# pgAdmin 4 Configuration
PGADMIN_DEFAULT_EMAIL=admin@rayuela.com
PGADMIN_DEFAULT_PASSWORD=pgadmin_rayuela_2024
PGADMIN_PORT=5050

# Cloudflare Tunnel Configuration (CARD-15 / NET-01)
# Opcional: Token de túnel nombrado en Cloudflare Zero Trust (si se usa dominio propio)
CLOUDFLARE_TUNNEL_TOKEN=tu_token_de_tunel_cloudflare_aqui

# MantisBT (CARD-19 / MAN-01): perfil "mantis" del compose
MANTIS_DB_PASSWORD=tu_password_mantis
MANTIS_DB_ROOT_PASSWORD=tu_password_root_mantis
MANTIS_CRYPTO_SALT=genera_una_cadena_aleatoria_larga
MANTIS_PORT=8081
# Poner en 1 solo la primera vez (instalar el esquema en /admin/install.php); despues, 0 o sin definir.
# MANTIS_ENABLE_ADMIN=0
MANTIS_API_TOKEN=tu_token_api_mantis
MANTIS_PROJECT_ID=1
MANTIS_CATEGORY_ID=1

# n8n (CARD sprint 4 / N8N-01): Despliegue de n8n y flujos de alertas de infraestructura y backups
N8N_PORT=5678
N8N_URL=http://127.0.0.1:5678
N8N_BASIC_AUTH_USER=n8n@gmail.com
N8N_BASIC_AUTH_PASSWORD=changeme
# Basic Auth del webhook de Grafana (nodo Webhook de n8n y contact point de Grafana)
N8N_WEBHOOK_BASIC_AUTH_USER=grafana-webhook
N8N_WEBHOOK_BASIC_AUTH_PASSWORD=cambia_esta_credencial
N8N_ENCRYPTION_KEY=genera_una_cadena_aleatoria_larga_y_larga

# Bootstrap de Fl.1 y Fl.2 (n8n/scripts/bootstrap_fl1.py)
# URL interna que usa Grafana para llegar a n8n dentro de Docker
N8N_INTERNAL_WEBHOOK_URL=http://n8n:5678/webhook/grafana-alerta
GRAFANA_URL=http://127.0.0.1:3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
GRAFANA_CONTACT_POINT_NAME=n8n
# Si no se definen y EMAIL_USER/EMAIL_PASS son reales, el bootstrap los usa
N8N_SMTP_USER=tu_correo@ejemplo.com
N8N_SMTP_PASSWORD=tu_password_de_aplicacion
N8N_SMTP_HOST=smtp.gmail.com
N8N_SMTP_PORT=465
N8N_SMTP_SECURE=true
N8N_ALERT_EMAIL_FROM=tu_correo@ejemplo.com
N8N_ALERT_EMAIL_TO=destinatario@ejemplo.com
